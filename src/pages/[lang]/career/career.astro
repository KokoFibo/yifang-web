---
import ContentCard from "../../../components/ContentCard.astro";
import HeroSection from "../../../components/HeroSection.astro";
import TitleHead from "../../../components/home/TitleHead.astro";
import Layout from "../../../layouts/Layout.astro";

import { getEntry } from "astro:content";
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}
const { lang } = Astro.params;
const entry = await getEntry("career", lang);
if (!entry) {
  throw new Error(`Data tidak ditemukan untuk bahasa: ${lang}`);
}
const { data } = entry;

// 🔥 SEO CONFIG
const seo = {
  en: {
    title:
      "Career Opportunities | Grow, Innovate, and Build Your Future with Us",
    description:
      "Join our team to innovate, make an impact, and grow your career through collaboration and long-term opportunities.",
    image: "/images/og/career-en-og.webp",
  },
  zh: {
    title:
      "职业发展机会｜加入我们共创未来，实现长期职业成长与个人价值全面提升的职业发展之路",
    description:
      "加入我们，与多元且充满活力的团队一起创新与创造，在协作、高效与持续成长的工作环境中不断提升专业能力，实现清晰的职业发展路径，将您的长期理想与个人目标逐步变为现实。",
    image: "/images/og/career-zh-og.webp",
  },
};

const { title, description, image } = seo[lang] ?? seo.en;
---

<Layout title={title} description={description} image={image}>
  <HeroSection
    companies={data.main.companies}
    url="/images/Edit-HEADER-CAREER-JOBS.webp"
    description={data.main.description}
    button={data.main.button}
  />

  <ContentCard
    subtitle={data.career.subtitle}
    title={data.career.title}
    descriptions={data.career.descriptions}
    imageUrl="/images/career/career-yifang.webp"
    alt="WHY-JOIN-US"
  />
  <TitleHead
    subtitle={data.honesty.subtitle}
    title={data.honesty.title}
    description={data.honesty.description}
  />
  <ContentCard
    subtitle={data.talent.subtitle}
    title={data.talent.title}
    descriptions={data.talent.descriptions}
    imageUrl="/images/career/talent-export.webp"
    alt="talent"
    reverse="false"
  />

  <ContentCard
    subtitle={data.development.subtitle}
    title={data.development.title}
    descriptions={data.development.descriptions}
    listItems={data.development.points}
    imageUrl="/images/career/talent-development.webp"
    alt="talent"
  />

  <ContentCard
    subtitle={data.recruitment.subtitle}
    title={data.recruitment.title}
    descriptions={data.recruitment.descriptions}
    listItems={data.recruitment.points}
    imageUrl="/images/career/recruitment-solutions.webp"
    alt="recruitment"
    reverse="false"
  />

  <ContentCard
    subtitle={data.leadership.subtitle}
    title={data.leadership.title}
    descriptions={data.leadership.descriptions}
    listItems={data.leadership.points}
    imageUrl="/images/career/leadership-development.webp"
    alt="talent"
  />
</Layout>

