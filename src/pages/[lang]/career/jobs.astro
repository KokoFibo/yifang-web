---
import ContentCard from "../../../components/ContentCard.astro";
import HeroSection from "../../../components/HeroSection.astro";
import Layout from "../../../layouts/Layout.astro";

import { getEntry } from "astro:content";
export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}
const { lang } = Astro.params;
const entry = await getEntry("jobs", lang);
if (!entry) {
  throw new Error(`Data tidak ditemukan untuk bahasa: ${lang}`);
}
const { data } = entry;

// 🔥 SEO CONFIG
const seo = {
  en: {
    title: "Job Opportunities | Build Your Career and Grow with Our Team",
    description:
      "Explore job opportunities with us and grow your career in a dynamic, innovative, and collaborative environment.",
    image: "/images/og/jobs-en-og.webp",
  },
  zh: {
    title:
      "招聘机会｜加入我们共创未来，开启长期职业成长与个人价值全面提升的职业发展之路，成就卓越事业",
    description:
      "加入我们，与多元且充满活力的团队一起创新与创造，在协作、高效与持续成长的工作环境中不断提升专业能力，全面实现长期职业目标与个人价值发展，成就卓越事业与未来。",
    image: "/images/og/jobs-zh-og.webp",
  },
};

const { title, description, image } = seo[lang] ?? seo.en;
---

<Layout title={title} description={description} image={image}>
  <HeroSection
    companies={data.main.companies}
    url="/images/Edit-HEADER-CAREER-JOBS.webp"
    description={data.main.description}
    button={data.main.button}
  />

  <ContentCard
    subtitle={data.why.subtitle}
    title={data.why.title}
    descriptions={data.why.descriptions}
    imageUrl="/images/jobs/why-join-us.webp"
    alt="WHY-JOIN-US"
  />

  <ContentCard
    subtitle={data.start.subtitle}
    title={data.start.title}
    descriptions={data.start.descriptions}
    imageUrl="/images/jobs/are-you-ready-to-turn-your-mandarin-skills-into-real-career-opportunities.webp"
    alt="are-you-ready-to-turn-your-mandarin-skills-into-real-career-opportunities"
    reverse="false"
  />

  <ContentCard
    subtitle={data.mandarin.subtitle}
    title={data.mandarin.title}
    descriptions={data.mandarin.descriptions}
    imageUrl="/images/jobs/explore-exciting-career-opportunities-at-yifang-group.webp"
    alt="explore-exciting-career-opportunities-at-yifang-group"
  />

  <ContentCard
    subtitle={data.mechanical.subtitle}
    title={data.mechanical.title}
    descriptions={data.mechanical.descriptions}
    imageUrl="/images/jobs/join-yifang-group.webp"
    alt="join-yifang-group"
    reverse="false"
  />
</Layout>

