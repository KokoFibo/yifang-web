---
import SectionTag from "./SectionTag.astro";
interface Props { data: any }
const { data } = Astro.props;
const f = data.formula;
---

<section class="relative bg-ba-red text-white py-20 md:py-[100px]">
  <SectionTag label={f.tag} tone="on-red" />

  <div class="mx-auto max-w-[1240px] px-7 grid grid-cols-1 md:grid-cols-[1.3fr_1fr] gap-10 md:gap-12">
    <div>
      <h2 class="flex flex-col gap-0.5 text-[24px] leading-[1.15] md:text-[40px] font-ba-display font-extrabold">
        {f.parts.map((p: string, i: number) => (
          <span class="ba-formula-part">
            {p}{i < f.parts.length - 1 && <span class="text-ba-lavender"> +</span>}
          </span>
        ))}
      </h2>
    </div>

    <div class="pt-8 border-t border-white/30 md:pt-0 md:pl-11 md:border-t-0 md:border-l">
      <span id="ba-formula-equals" class="block font-ba-display font-extrabold text-[30px]" aria-hidden="true">=</span>
      <p id="ba-formula-result" class="mt-3.5 font-ba-display font-extrabold text-[26px] leading-[1.1] md:text-[36px]">{f.result}</p>
      <p class="mt-5.5 max-w-[320px] text-[14.5px] leading-[1.6] text-white/85">{f.caption}</p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".ba-formula-part", {
    scrollTrigger: { trigger: ".ba-formula-part", start: "top 85%" },
    x: -20,
    opacity: 0,
    duration: 0.5,
    stagger: 0.12,
    ease: "power2.out",
  });

  gsap.from("#ba-formula-result", {
    scrollTrigger: { trigger: "#ba-formula-result", start: "top 85%" },
    scale: 0.85,
    opacity: 0,
    duration: 0.6,
    ease: "back.out(1.6)",
    delay: 0.2,
  });
</script>
