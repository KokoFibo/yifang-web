---
import SectionTag from "./SectionTag.astro";
interface Props { data: any }
const { data } = Astro.props;
const i = data.invite;
---

<section class="relative bg-white py-20 md:py-[110px]">
  <SectionTag label={i.tag} tone="on-light" />

  <div class="mx-auto max-w-[1240px] px-7 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14">
    <div id="ba-invite-copy">
      <p class="font-ba-mono text-xs tracking-[0.14em] uppercase text-ba-red mb-4.5">{i.eyebrow}</p>
      <h2 class="font-ba-display font-extrabold text-ba-ink text-[28px] leading-[1.05] md:text-[46px]">
        {i.titlePre}<br />
        <span class="text-ba-red">{i.titleAccent1}<br />{i.titleAccent2}</span>
      </h2>
      <p class="mt-5.5 max-w-[340px] text-[15.5px] text-ba-ink-muted">{i.desc}</p>
    </div>

    <div class="flex flex-col">
      {i.checks.map((c: any, idx: number) => (
        <div class={`ba-invite-row flex items-start gap-3.5 py-5.5 border-b border-black/13 ${idx === 0 ? "border-t" : ""}`}>
          <svg class="mt-1 flex-shrink-0 text-ba-red" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8.5L6 12.5L13.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <h3 class="font-ba-mono text-[13px] tracking-[0.06em] uppercase font-semibold text-ba-ink">{c.label}</h3>
            <p class="mt-1.5 text-[14.5px] text-ba-ink-muted">{c.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from("#ba-invite-copy", {
    scrollTrigger: { trigger: "#ba-invite-copy", start: "top 82%" },
    y: 20,
    opacity: 0,
    duration: 0.6,
    ease: "power3.out",
  });

  gsap.from(".ba-invite-row", {
    scrollTrigger: { trigger: ".ba-invite-row", start: "top 85%" },
    x: 16,
    opacity: 0,
    duration: 0.5,
    stagger: 0.12,
    ease: "power2.out",
  });
</script>
