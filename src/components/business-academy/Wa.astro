---
import SectionTag from "./SectionTag.astro";
interface Props { data: any }
const { data } = Astro.props;
const w = data.wa;
const ph = w.phone;
---

<section class="relative bg-white py-20 md:py-[110px]" id="channel">
  <SectionTag label={w.tag} tone="on-light" />

  <div class="mx-auto max-w-[1240px] px-7 grid grid-cols-1 md:grid-cols-[1fr_0.85fr] gap-11 items-center">
    <div id="ba-wa-copy">
      <p class="font-ba-mono text-xs tracking-[0.14em] uppercase text-ba-red mb-4.5">{w.eyebrow}</p>
      <h2 class="font-ba-display font-extrabold text-ba-ink text-[28px] leading-[1.05] md:text-[46px]">
        {w.titleLine1}<br />
        <span class="text-ba-red">{w.titleAccent}</span>
      </h2>
      <p class="mt-5 max-w-[380px] text-[15.5px] text-ba-ink-muted">{w.desc}</p>

      <ul class="mt-7.5 grid grid-cols-1 md:grid-cols-2 gap-x-7.5 gap-y-3 list-none p-0">
        {w.perks.map((p: string) => (
          <li class="ba-wa-perk flex items-center gap-2.5 text-[15px] text-ba-ink">
            <svg class="flex-shrink-0 text-ba-red" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7L5.5 10.5L12 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {p}
          </li>
        ))}
      </ul>

      <a
        href="#daftar"
        class="mt-9 flex w-full items-center justify-center gap-2.5 border border-black/13 px-7 py-4 font-ba-mono text-[13px] font-semibold tracking-[0.06em] uppercase text-ba-ink transition-colors duration-200 hover:border-ba-ink sm:inline-flex sm:w-auto"
      >
        {w.cta}
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M4 11L11 4M11 4H5M11 4V10" stroke="currentColor" stroke-width="1.6"/></svg>
      </a>
    </div>

    <div id="ba-wa-visual" class="flex justify-center">
      <div class="w-[260px] rounded-[26px] bg-ba-black p-3.5 shadow-[0_30px_60px_-24px_rgba(12,12,12,0.4)]">
        <div class="font-ba-mono text-[11px] text-ba-paper/60 px-1.5 pt-1 pb-3.5">9:41</div>
        <div class="flex items-center gap-2.5 px-1.5 pb-4">
          <span class="flex h-8.5 w-8.5 flex-shrink-0 items-center justify-center rounded-full bg-ba-red font-extrabold text-white">Y</span>
          <div>
            <strong class="block text-[13px] font-bold text-ba-paper">{ph.name}</strong>
            <span class="block text-[10.5px] text-ba-paper/60 mt-0.5">{ph.sub}</span>
          </div>
        </div>

        <div class="mx-1.5 mb-3 rounded-sm p-3.5 bg-ba-red text-white">
          <span class="font-ba-mono text-[9.5px] tracking-[0.06em] uppercase opacity-75">{ph.bubble1Tag}</span>
          <p class="mt-2 text-[13px] font-bold leading-[1.4]">{ph.bubble1Text}</p>
          <span class="mt-2.5 block font-ba-mono text-[9.5px] opacity-65">{ph.bubble1Time}</span>
        </div>

        <div class="mx-1.5 mb-3 rounded-sm p-3.5 bg-ba-black-soft text-ba-paper border border-white/16">
          <span class="font-ba-mono text-[9.5px] tracking-[0.06em] uppercase opacity-75">{ph.bubble2Tag}</span>
          <p class="mt-2 text-[13px] font-bold leading-[1.4]">{ph.bubble2Text}</p>
          <span class="mt-2.5 block font-ba-mono text-[9.5px] opacity-65">{ph.bubble2Time}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { revealGroup } from "../../scripts/scrollReveal.js";

  revealGroup("#ba-wa-copy", {
    start: "top 82%",
    y: 20,
    duration: 0.6,
    ease: "power3.out",
  });

  revealGroup(".ba-wa-perk", {
    start: "top 88%",
    x: -10,
    duration: 0.4,
    stagger: 0.06,
  });

  revealGroup("#ba-wa-visual", {
    start: "top 82%",
    y: 30,
    duration: 0.7,
    ease: "power3.out",
  });
</script>
