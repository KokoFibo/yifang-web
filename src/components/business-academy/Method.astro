---
import SectionTag from "./SectionTag.astro";
interface Props { data: any }
const { data } = Astro.props;
const m = data.method;
---

<section class="relative bg-white py-20 md:py-[110px]" id="program">
  <SectionTag label={m.tag} tone="on-light" />

  <div class="mx-auto max-w-[1240px] px-7">
    <p class="font-ba-mono text-xs tracking-[0.14em] uppercase text-ba-red mb-4.5">{m.eyebrow}</p>
    <h2 class="font-ba-display font-extrabold text-ba-ink text-[28px] leading-[1.05] md:text-[48px]">
      {m.titleLine1}<br />
      <span class="text-ba-red">{m.titleAccent}</span>
    </h2>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-3">
      {m.steps.map((s: any, i: number) => (
            <div class={`ba-method-card relative min-h-[260px] flex flex-col justify-between px-6.5 pt-7 pb-14 border-black/13 ${i === 0 ? "border" : "border-r border-b border-l md:border-t md:border-l-0"} ${s.muted ? "bg-ba-offwhite text-ba-ink-muted" : ""}`}>
            <span class="font-ba-mono text-xs text-ba-red">{s.n}</span>
            <div>
              <h3 class={`mt-10 text-xl font-extrabold uppercase ${s.muted ? "text-ba-ink-muted" : "text-ba-ink"}`}>{s.label}</h3>
              <p class="mt-3 text-[14.5px] leading-[1.55] text-ba-ink-muted">{s.body}</p>
            </div>
            <svg class="absolute right-5 bottom-5 text-ba-red" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.4"/></svg>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".ba-method-card", {
    scrollTrigger: { trigger: ".ba-method-card", start: "top 85%" },
    y: 30,
    opacity: 0,
    duration: 0.6,
    stagger: 0.15,
    ease: "power2.out",
  });
</script>
