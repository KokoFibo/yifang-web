---
import SectionTag from "./SectionTag.astro";
interface Props { data: any }
const { data } = Astro.props;
const p = data.proof;
const videoId = "Ke7yErmqFq8";
---

<section class="relative bg-ba-black text-ba-paper py-20 md:py-[100px]">
  <SectionTag label={p.tag} tone="on-dark" />

  <div class="mx-auto max-w-[1240px] px-7 grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-14 items-start">
    <div id="ba-proof-media">
      <img
        src="/images/business-academy/team-office.webp"
        alt="Tim Yifang Group berdiskusi"
        width="1200"
        height="800"
        loading="lazy"
        class="w-full aspect-[4/3] object-cover saturate-90 contrast-[1.05]"
      />

      <button
        type="button"
        class="block w-full mt-1 bg-ba-red-deep text-left text-white cursor-pointer p-0"
        id="ba-proof-video"
        data-video-id={videoId}
        aria-label={p.videoTitle}
      >
        <span class="flex items-center gap-2.5 px-3.5 py-3 bg-black/18">
          <span class="flex h-5.5 w-5.5 flex-shrink-0 items-center justify-center rounded-full bg-white text-[11px] font-extrabold text-ba-red-deep">易</span>
          <span>
            <strong class="block text-[13px] font-bold leading-[1.3]">{p.videoHeadline}</strong>
            <em class="mt-0.5 block text-[11px] not-italic opacity-75">{p.videoChannel}</em>
          </span>
        </span>
        <span
          class="ba-proof-video-body relative flex aspect-video items-center justify-center bg-cover bg-center"
          style={`background-image:url(https://img.youtube.com/vi/${videoId}/hqdefault.jpg)`}
        >
          <span class="absolute inset-0 bg-gradient-to-b from-ba-red/35 to-ba-red-deep/75"></span>
          <span class="relative flex h-13 w-13 items-center justify-center rounded-full bg-white text-ba-red-deep">
            <svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor" aria-hidden="true"><path d="M0 0L16 9L0 18V0Z"/></svg>
          </span>
          <span class="absolute left-4 bottom-3.5 font-ba-display font-extrabold text-xl text-ba-cream">{p.videoTitle}</span>
        </span>
      </button>
    </div>

    <div class="relative">
      <p class="font-ba-mono text-xs tracking-[0.14em] uppercase text-ba-red">{p.eyebrow}</p>
      <span class="hidden md:flex absolute top-0 right-0 flex-col items-center border border-white/16 px-3.5 py-2.5 font-ba-mono">
        <span class="text-[9.5px] tracking-[0.08em] uppercase text-ba-paper/60">{p.caseLabel}</span>
        <span class="text-[15px] font-bold text-ba-lavender">{p.caseNum}</span>
      </span>

      <h2 id="ba-proof-title" class="mt-4.5 font-ba-display font-extrabold text-ba-paper text-[28px] leading-[1.05] md:text-[46px]">
        {p.titleLine1}<br />
        <span class="text-ba-lavender">{p.titleAccent}</span>
      </h2>

      {p.paragraphs.map((t: string) => (
        <p class="ba-proof-text mt-5 max-w-[440px] text-[15.5px] leading-[1.7] text-ba-paper/60">{t}</p>
      ))}
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('ba-proof-video');
  btn?.addEventListener('click', () => {
    const videoId = btn.getAttribute('data-video-id');
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', 'true');
    iframe.style.cssText = 'width:100%;height:100%;position:absolute;inset:0;border:0;';
    const body = btn.querySelector('.ba-proof-video-body') as HTMLElement | null;
    if (body) {
      body.style.position = 'relative';
      body.innerHTML = '';
      body.appendChild(iframe);
    }
  }, { once: true });
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from("#ba-proof-media", {
    scrollTrigger: { trigger: "#ba-proof-media", start: "top 82%" },
    x: -24,
    opacity: 0,
    duration: 0.7,
    ease: "power3.out",
  });

  gsap.from("#ba-proof-title, .ba-proof-text", {
    scrollTrigger: { trigger: "#ba-proof-title", start: "top 82%" },
    y: 18,
    opacity: 0,
    duration: 0.6,
    stagger: 0.12,
    ease: "power2.out",
  });
</script>
