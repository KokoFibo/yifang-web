---
import SectionTag from "./SectionTag.astro";
interface Props { data: any }
const { data } = Astro.props;
const p = data.problem;
---

<section class="relative bg-ba-black text-ba-paper py-20 md:py-[100px]">
  <SectionTag label={p.tag} tone="on-dark" />

  <div class="mx-auto max-w-[1240px] px-7">
    <p id="ba-problem-eyebrow" class="font-ba-mono text-xs tracking-[0.14em] uppercase text-ba-red mb-5">{p.eyebrow}</p>
    <h2 id="ba-problem-title" class="font-ba-display font-extrabold text-ba-paper text-[28px] leading-[1.05] max-w-[780px] md:text-[46px]">
      {p.titleLine1}<br />
      <span class="text-ba-lavender">{p.titleAccent}</span> {p.titleRest}
    </h2>

    <div class="ba-problem-grid mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-white/16">
      {p.cards.map((c: any) => (
        <div class="ba-problem-card relative min-h-[200px] px-6 pt-7 pb-13 border-r border-b border-white/16">
          <span class="font-ba-mono text-xs text-ba-red">{c.n}</span>
          <p class="mt-4.5 font-ba-display font-bold text-lg leading-[1.3] text-ba-paper">{c.quote}</p>
          <p class="mt-3 text-sm leading-[1.55] text-ba-paper/60">{c.body}</p>
          <svg class="absolute right-5 bottom-5 text-ba-red" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.4"/></svg>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from("#ba-problem-eyebrow, #ba-problem-title", {
    scrollTrigger: { trigger: "#ba-problem-title", start: "top 85%" },
    y: 20,
    opacity: 0,
    duration: 0.7,
    stagger: 0.1,
    ease: "power3.out",
  });

  gsap.from(".ba-problem-card", {
    scrollTrigger: { trigger: ".ba-problem-grid", start: "top 85%" },
    y: 30,
    opacity: 0,
    duration: 0.6,
    stagger: 0.12,
    ease: "power2.out",
  });
</script>
