---
const { companies = [], description, url, button } = Astro.props;
---

<!-- sebaiknya image size 1920 X 600px -->
<section
  class="relative h-screen max-h-120 flex items-center overflow-hidden
         bg-cover bg-center bg-no-repeat"
  style={`background-image: url(${url});`}
>
  <div class="absolute inset-0 bg-black/60"></div>
  <div class="relative z-10 container mx-auto px-4 sm:px-6 md:px-12 pt-20 max-w-7xl">
    <div
      id="hero-content"
      class="text-white border-l-2 border-primary pl-4 sm:pl-6 opacity-0"
    >
      <h1
        class="hero-title font-bold tracking-tight leading-tight uppercase text-white whitespace-nowrap text-[clamp(0.85rem,4.3vw,3rem)]"
      >
        {companies.join(" ")}
      </h1>

      <p
        class="hero-text mt-4 max-w-md md:max-w-xl text-base md:text-lg text-white/90 font-light leading-relaxed tracking-wide"
      >
        {description}
      </p>

      <div class="hero-button mt-6">
        <div class="h-px w-12 bg-white/50 mb-4"></div>
        <button
          class="text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-white/90 hover:text-white transition-colors duration-300 border-b border-transparent hover:border-white pb-1"
        >
          {button}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  window.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    // Container muncul duluan
    tl.to("#hero-content", {
      opacity: 1,
      duration: 0.8,
    })
      // Judul muncul dengan sedikit pergeseran ke atas
      .from(
        ".hero-title",
        {
          y: 20,
          opacity: 0,
          duration: 1,
        },
        "-=0.4"
      )
      // Paragraf muncul setelahnya
      .from(
        ".hero-text",
        {
          y: 15,
          opacity: 0,
          duration: 0.8,
        },
        "-=0.6"
      )
      // Garis dekorasi dan tombol muncul terakhir
      .from(
        ".hero-button",
        {
          opacity: 0,
          duration: 0.8,
        },
        "-=0.4"
      );
  });
</script>
